I2 nV 0 DC 1m AC 0.5m
B2 nD 0 V=1
B3 nJ1s 0 V=1
B4 nE 0 V=1
B5 nE2 0 V=1
D2 nV 0 off Dmod
J2 nV 0 nJ1s off Jmod
Q3 nV nJ1s nV Qmod
Z2 nV 0 nJ1s off Zmod
O2 nV 0 {nJ1s} {0} Omod
Y2 nV 0 {nJ1s} {0} Ymod
B6 nV 0 V=1